{
  "manifest_version": 3,
  "name": "FoE Companion — baza",
  "version": "0.6.12",
  "version_name": "0.6.12",
  "background": {"service_worker":"background.js"},
  "permissions": ["storage","tabs","activeTab"],
  "host_permissions": ["http://127.0.0.1/*","https://*.forgeofempires.com/*","https://discord.com/api/*","<all_urls>"],
  "description": "Lokalny panel danych Forge of Empires i rozpiska Pól Chwały.",
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {"resources":["sectors.json","sectors-volcano.json","building-names.json","building-fp-types.json","quantum-definitions.json"],"matches":["https://*.forgeofempires.com/*"]}
  ],
  "content_scripts": [
    {"matches":["https://*.forgeofempires.com/*"],"js":["request-signature.js","battle-army.js","battleground-live.js","pearls-main.js","capture.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://*.forgeofempires.com/*"],"js":["pearls.js","model.js","quantum.js","quantum-history.js","notes.js","sector-automation.js","discord.js","panel.js","dev-client.js"],"run_at":"document_start"}
  ]
}
