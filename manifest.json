{
  "manifest_version": 3,
  "name": "FoE Companion — baza",
  "version": "0.3.0",
  "background": {"service_worker":"background.js"},
  "host_permissions": ["http://127.0.0.1/*"],
  "description": "Lokalny panel danych Forge of Empires i rozpiska Pól Chwały.",
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {"resources":["sectors.json","sectors-volcano.json","building-names.json","quantum-definitions.json"],"matches":["https://*.forgeofempires.com/*"]}
  ],
  "content_scripts": [
    {"matches":["https://*.forgeofempires.com/*"],"js":["capture.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://*.forgeofempires.com/*"],"js":["pearls.js","model.js","quantum.js","notes.js","panel.js","dev-client.js"],"run_at":"document_start"}
  ]
}
